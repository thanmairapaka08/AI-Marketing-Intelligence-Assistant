# FastAPI backend base URL (all application routes live under /api/v1).
# Tip: use "localhost" (not 127.0.0.1) if the frontend runs on localhost so
# HttpOnly auth cookies stay same-site.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional: backend root used for /health, /ready and /openapi.json.
# Defaults to VITE_API_BASE_URL with the trailing /api/v1 removed.
# VITE_API_ROOT_URL=http://127.0.0.1:8000
